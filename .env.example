# Global env loader
GLOBAL_ENV_PATH=/home/juan/Documents/.env

# Server
AGENT_SERVER_HOST=127.0.0.1
AGENT_SERVER_PORT=8070
AGENT_SERVER_NAME=langgraph-agent-server
AGENT_DATA_DIR=./data

# Providers
DEFAULT_REASONING_PROVIDER=deepseek
DEFAULT_PLANNER_PROVIDER=gemini
DEFAULT_SPECIAL_PROVIDER=openai

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT_SECONDS=60
GEMINI_API_KEY=
OPENAI_API_KEY=

DEEPSEEK_TEXT_MODEL=deepseek-chat
GEMINI_SUPERVISOR_MODEL=gemini-2.5-pro
OPENAI_SPECIAL_MODEL=gpt-4.1-mini

# External backends
TERMINAL_TOOLS_BASE_URL=http://127.0.0.1:8090
TERMINAL_TOOLS_MCP_URL=http://127.0.0.1:8091/mcp/
RAG_SERVER_BASE_URL=http://127.0.0.1:8000
RAG_SERVER_MCP_URL=http://127.0.0.1:8081
RAG_DEFAULT_TENANT_ID=tenant-stack-probe
CELERY_SERVER_BASE_URL=http://127.0.0.1:8011
CELERY_SERVER_MCP_URL=http://127.0.0.1:8082/mcp
HAPI_BASE_URL=http://127.0.0.1:8095
HAPI_MCP_URL=http://127.0.0.1:8096/mcp/

# HTTP timeouts
BACKEND_TIMEOUT_SECONDS=20

# UI Factory
UI_FACTORY_DEPLOY_MAX_ATTEMPTS=3
UI_FACTORY_DEPLOY_RETRY_DELAY_SECONDS=8

# LangSmith tracing
LANGSMITH_ENABLED=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=langgraph-agent-server
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
