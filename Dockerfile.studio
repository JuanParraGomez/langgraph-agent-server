FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY pyproject.toml README.md /app/
COPY app /app/app
COPY scripts /app/scripts
COPY langgraph.json /app/langgraph.json
COPY .env.studio /app/.env.studio

# Install project deps + langgraph-cli with inmem backend
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir . && \
    pip install --no-cache-dir "langgraph-cli[inmem]"

RUN mkdir -p /app/data/runs /app/data/logs

EXPOSE 8123

# langgraph dev serves the LangGraph API compatible with Studio
# --no-reload avoids noisy restarts in container; use docker restart for updates
CMD ["langgraph", "dev", "--host", "0.0.0.0", "--port", "8123", \
     "--no-reload", "--no-browser", "--config", "/app/langgraph.json"]
