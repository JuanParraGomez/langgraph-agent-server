# Global env loader
GLOBAL_ENV_PATH=/home/juan/Documents/.env

# Server
AGENT_SERVER_HOST=127.0.0.1
AGENT_SERVER_PORT=8070
AGENT_SERVER_NAME=langgraph-agent-server
AGENT_DATA_DIR=./data

# Providers
DEFAULT_REASONING_PROVIDER=deepseek
DEFAULT_PLANNER_PROVIDER=gemini
DEFAULT_SPECIAL_PROVIDER=openai

DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

DEEPSEEK_TEXT_MODEL=deepseek-chat
GEMINI_SUPERVISOR_MODEL=gemini-2.5-pro
OPENAI_SPECIAL_MODEL=gpt-4.1-mini

# External backends
TERMINAL_TOOLS_BASE_URL=http://127.0.0.1:8090
TERMINAL_TOOLS_MCP_URL=http://127.0.0.1:8090/mcp
RAG_SERVER_BASE_URL=http://127.0.0.1:8000
RAG_SERVER_MCP_URL=http://127.0.0.1:8081
CELERY_SERVER_BASE_URL=http://127.0.0.1:8010
CELERY_SERVER_MCP_URL=http://127.0.0.1:8010/mcp

# HTTP timeouts
BACKEND_TIMEOUT_SECONDS=20
