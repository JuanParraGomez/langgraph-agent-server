# LangGraph Studio env – non-secret configuration only.
# The LANGSMITH_API_KEY must come from /home/juan/.config/langsmith/langsmith.env
# or from the host's /home/juan/Documents/.env (which docker-compose mounts).
# DO NOT add secrets here.

LANGSMITH_ENABLED=true
LANGSMITH_TRACING=true
LANGSMITH_ENFORCE=false
LANGSMITH_PROJECT=langgraph-agent-server-studio
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_WORKSPACE_ID=ec45ad58-425c-4956-ada0-2cba64190c20

# Backend connections – local dev paths (Docker build overrides these via Dockerfile.studio)
# When running via Docker, AGENT_DATA_DIR and GLOBAL_ENV_PATH are mounted at the correct paths.
GLOBAL_ENV_PATH=/home/juan/Documents/.env
AGENT_DATA_DIR=/home/juan/Documents/langgraph-agent-server/data
TERMINAL_TOOLS_BASE_URL=http://127.0.0.1:8090
RAG_SERVER_BASE_URL=http://127.0.0.1:8000
CELERY_SERVER_BASE_URL=http://127.0.0.1:8011
HAPI_BASE_URL=http://127.0.0.1:8095
RAG_DEFAULT_TENANT_ID=tenant-stack-probe
BACKEND_TIMEOUT_SECONDS=20
